# Copy this file to `.env` and fill in your real values.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Anthropic API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
CLAUDE_MODEL=claude-opus-4-8
MAX_TOKENS=4096
# Comma-separated Telegram user IDs allowed to use the bot. Leave empty to allow everyone.
ALLOWED_USER_IDS=
# System prompt the bot uses for every conversation.
SYSTEM_PROMPT=You are a helpful assistant chatting with users over Telegram. Keep replies concise and friendly.
