# ── Anthropic / Claude 설정 ───────────────────────────────
# https://console.anthropic.com 에서 발급받은 API 키
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 모델 (기본: Claude Opus 4.8)
#  - claude-opus-4-8   : 가장 똑똑함 (기본)
#  - claude-sonnet-4-6 : 속도/비용 균형
#  - claude-haiku-4-5  : 가장 빠르고 저렴
CLAUDE_MODEL=claude-opus-4-8

# 응답 최대 토큰 수 (thinking 토큰 포함)
MAX_TOKENS=2048

# adaptive thinking 사용 여부 (true=더 똑똑함, false=더 빠름)
ENABLE_THINKING=true

# 챗봇 페르소나 / 시스템 프롬프트
SYSTEM_PROMPT=당신은 카카오톡 채널에서 사용자를 돕는 친절한 AI 어시스턴트입니다. 한국어로 자연스럽고 간결하게 답변하세요. 카카오톡 메시지는 길면 잘릴 수 있으니 답변은 가능한 한 1000자 이내로 작성하세요.

# 사용자별로 기억할 최근 대화 턴 수
HISTORY_MAX_TURNS=6

# Claude 응답 대기 최대 시간(초). 카카오 콜백은 1분 이내 응답해야 함
REQUEST_TIMEOUT=50
